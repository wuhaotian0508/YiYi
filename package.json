{
  "name": "yiyi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "vitest run tests/unit/recommendation.property.test.ts tests/unit/recommendation-mutations.test.ts tests/unit/voice-session-coordinator.test.ts tests/unit/release-recommendation-eval.test.ts tests/unit/provider-route-faults.test.ts tests/unit/rate-limit.test.ts",
    "test:watch": "vitest",
    "test:motion": "playwright test --config=playwright.motion.config.ts",
    "test:e2e": "playwright test",
    "test:trust": "playwright test tests/e2e/trust-a11y.spec.ts",
    "analyze:bundle": "next experimental-analyze --output .",
    "audit:secrets": "node release-audit/06-release/secret-scan.mjs",
    "release:archive": "node scripts/build-release-archive.mjs",
    "audit:production": "pnpm audit --prod --audit-level high",
    "verify:sharp": "node scripts/verify-sharp-runtime.mjs",
    "verify:realtime-tool": "node scripts/verify-realtime-tool-lifecycle.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@openai/agents": "0.13.4",
    "@supabase/supabase-js": "^2.109.0",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "gsap": "3.15.0",
    "lucide-react": "1.24.0",
    "motion": "12.42.2",
    "next": "16.2.10",
    "openai": "6.48.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.34.5",
    "swiper": "14.0.5",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.3.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
