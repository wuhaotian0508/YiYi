# Server only
OPENAI_API_KEY=
# Optional OpenAI-compatible text understanding endpoint. CRS requires a
# server-only API key because its Responses API is stream-only.
CRS_API_KEY=
OPENAI_LANGUAGE_BASE_URL=
OPENAI_LANGUAGE_MODEL=gpt-5.5
# Visual ranking endpoint. Defaults to OPENAI_LANGUAGE_BASE_URL, so a CRS-hosted
# vision model is used with CRS_API_KEY. Leave both unset to rank on OpenAI.
OPENAI_RANK_BASE_URL=
OPENAI_ITEM_MODEL=gpt-5.6-terra
OPENAI_RANK_MODEL=gpt-5.6
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_REALTIME_VOICE=marin
PHOTOROOM_API_KEY=

# Optional browser-side cloud sync. Do not add a service-role or other secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Modes
AI_MODE=mock
# mock, browser (Web Speech API), or live (OpenAI Realtime)
NEXT_PUBLIC_VOICE_MODE=mock
NEXT_PUBLIC_WEATHER_MODE=device-location
NEXT_PUBLIC_SEED_DEMO_WARDROBE=false
NEXT_PUBLIC_ENABLE_CUTOUT_EDITOR=false

# Optional production rate limit. Both values are required for live production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Server-only Shopify Admin API configuration for purchase-history import.
SHOPIFY_STORE_DOMAIN=yiyi-wardrobe-lab.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
